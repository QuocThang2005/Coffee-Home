# Coffee Home — Production Environment Variables
# Copy to .env and fill in real values before deploying

# ---- Database ----
DB_PASSWORD=change-me-strong-password

# ---- Backend ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
JWT_SECRET=change-me-to-random-64-chars
ADMIN_EMAIL=admin@coffeehome.vn
ADMIN_PASSWORD=change-me-strong-password
ALLOWED_ORIGINS=https://coffeehome.vn,https://www.coffeehome.vn

# ---- Nginx ports ----
NGINX_PORT=80
NGINX_SSL_PORT=443

# ---- Domain (for certbot) ----
DOMAIN=coffeehome.vn
